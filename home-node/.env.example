# ─────────────────────────────────────────────────────────────────────────────
# MoviePlayer VR Cinema – Home Node Environment Variables
# Copy this file to .env and fill in your values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudflare Zero Trust ─────────────────────────────────────────────────────
# Obtain from https://one.dash.cloudflare.com → Networks → Tunnels → Create tunnel
# Select "Docker" and copy the token shown in the install command.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── Cloud Relay API ───────────────────────────────────────────────────────────
# Base URL of the MoviePlayer cloud relay service (no trailing slash).
# This is used for:
#   • HLS auth delegation (POST ${CLOUD_API_URL}/auth/hls)
#   • Library sync (POST ${CLOUD_API_URL}/library/sync)
CLOUD_API_URL=https://api.your-movieplayer-cloud.example.com

# ── Shared API Secret ─────────────────────────────────────────────────────────
# A long random string shared between the home-node packager and the cloud relay.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET=change_me_to_a_long_random_secret

# ── Media Library ─────────────────────────────────────────────────────────────
# Absolute path on the HOST machine to your movies folder.
# On Windows use forward slashes or escape backslashes:
#   MEDIA_DIR=C:/Users/yourname/Movies
#   MEDIA_DIR=D:/Media/VR
# On Linux/Mac:
#   MEDIA_DIR=/mnt/nas/movies
MEDIA_DIR=/your/movies/folder

# ── Clarity Pack Output ───────────────────────────────────────────────────────
# Absolute path on the HOST machine where upscaled Clarity Pack files are stored.
# Needs sufficient disk space (~20-80 GB per movie for HSBS 4K HEVC).
# Can be the same drive as MEDIA_DIR or a separate high-speed drive.
CLARITY_PACK_DIR=/your/clarity/output/folder

# ── Clarity Worker Mode ───────────────────────────────────────────────────────
# Set to 1 to skip Real-ESRGAN and use FFmpeg sharpening only (much faster).
# Useful if you have no GPU or want a quick preview.
# 0 = full AI upscale (slow, best quality)
# 1 = fast FFmpeg-only mode (minutes instead of hours per movie)
CLARITY_FAST_MODE=0
