# ─────────────────────────────────────────────────────────────────────────────
# MoviePlayer VR Cinema – Home Node Environment Variables
# Copy this file to .env and fill in your values before running docker compose.
#
# No accounts, no tokens, no cloud subscriptions needed.
# Total cost: $0 / month.
# ─────────────────────────────────────────────────────────────────────────────

# ── Media Library ─────────────────────────────────────────────────────────────
# Absolute path on your HOST PC to the folder that contains your movie files.
# Supported formats: MKV, MP4, and any SBS/OU 3D video FFmpeg can read.
#
# Windows examples (always use forward slashes):
#   MEDIA_DIR=C:/Users/YourName/Movies
#   MEDIA_DIR=D:/Media/VR
#
# Linux / Mac:
#   MEDIA_DIR=/home/yourname/movies
#   MEDIA_DIR=/mnt/nas/vr-movies
MEDIA_DIR=C:/Users/yourname/Movies

# ── Clarity Pack Output ───────────────────────────────────────────────────────
# Absolute path where the clarity worker writes upscaled output files.
# Needs plenty of disk space (~20-80 GB per movie for HSBS 4K HEVC).
# Can be the same drive as MEDIA_DIR or a separate fast drive.
CLARITY_PACK_DIR=C:/Users/yourname/ClarityPacks

# ── Clarity Worker Mode ───────────────────────────────────────────────────────
# 0 = full AI upscale via Real-ESRGAN (slow, best quality, needs a GPU)
# 1 = fast FFmpeg-only sharpening (minutes per movie, no GPU required)
CLARITY_FAST_MODE=0
